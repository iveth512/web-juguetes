# OPCIONAL. docker-compose.yml ya trae todo lo necesario para correr en local.
# Copia este archivo a backend/.env solo si quieres cambiar algo.

# Pagos reales en modo pruebas con tu propia cuenta de Bold (https://bold.co):
# PAYMENTS_PROVIDER=bold
# BOLD_API_KEY=tu-llave-de-identidad-de-pruebas
# BOLD_SECRET_KEY=tu-llave-secreta-de-pruebas
# BOLD_ENVIRONMENT=sandbox

# Login con Google (tu propio cliente OAuth; agrega http://localhost:3000
# como origen autorizado). En el frontend define tambien
# NEXT_PUBLIC_GOOGLE_CLIENT_ID con el mismo valor.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Correos: por defecto se imprimen en la consola del backend.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
